def plot_timeseries(data, x, y, title, x_label, y_label, color_col=None):
    """Create a professional time series plot."""
    if data.empty or data[[x, y]].isna().all().any():
        st.warning(f"No data available for {title}")
        return None
    
    data_sorted = data.sort_values(x)
    
    if color_col and color_col in data.columns:
        fig = px.line(
            data_sorted, x=x, y=y,
            color=color_col,
            title=title,
            labels={x: x_label, y: y_label},
            height=500,
        )
    else:
        fig = px.line(
            data_sorted, x=x, y=y,
            title=title,
            labels={x: x_label, y: y_label},
            height=500,
        )
    
    fig.update_traces(
        hovertemplate="<b>%{x|%Y-%m-%d}</b><br>" + y_label + ": %{y:,.0f}<extra></extra>"
    )
    fig.update_layout(
        template="plotly_white",
        font=dict(size=12),
        title_font_size=16,
        hovermode="x unified",
        margin=dict(l=80, r=50, t=100, b=80),
    )
    return fig


def missing_values_table(df):
    """Create a table showing missing values."""
    missing = pd.DataFrame({
        'Column': df.columns,
        'Missing Count': df.isnull().sum(),
        'Missing %': (df.isnull().sum() / len(df) * 100).round(2)
    })
    missing = missing[missing['Missing Count'] > 0].sort_values('Missing %', ascending=False)
    return missing


