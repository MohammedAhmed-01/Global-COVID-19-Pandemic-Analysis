def plot_bar(data, x, y, title, x_label, y_label, color=None, orientation="v"):
    """Create a professional bar chart."""
    if data.empty:
        st.warning(f"No data available for {title}")
        return None
    
    if orientation == "h":
        fig = px.bar(
            data, x=y, y=x,
            title=title,
            labels={y: y_label, x: x_label},
            color=color,
            orientation="h",
            height=600,
        )
    else:
        fig = px.bar(
            data, x=x, y=y,
            title=title,
            labels={x: x_label, y: y_label},
            color=color,
            height=600,
        )
    
    fig.update_traces(
        hovertemplate="<b>%{x}</b><br>" + y_label + ": %{y:,.0f}<extra></extra>"
    )
    fig.update_layout(
        template="plotly_white",
        font=dict(size=12),
        title_font_size=16,
        showlegend=False,
        margin=dict(l=80, r=50, t=100, b=80),
    )
    return fig


def plot_histogram(data, col, title, x_label, color="#667eea"):
    """Create a professional histogram."""
    if data[col].isna().all():
        st.warning(f"No data available for {title}")
        return None
    
    fig = px.histogram(
        data, x=col,
        title=title,
        labels={col: x_label},
        nbins=30,
        height=500,
    )
    fig.update_traces(marker_color=color, hovertemplate=f"{x_label}: %{{x:.2f}}<br>Count: %{{y}}<extra></extra>")
    fig.update_layout(
        template="plotly_white",
        font=dict(size=12),
        title_font_size=16,
        showlegend=False,
        margin=dict(l=80, r=50, t=100, b=80),
    )
    return fig


def plot_scatter(data, x, y, title, x_label, y_label, color_col=None, size_col=None):
    """Create a professional scatter plot."""
    if data.empty or data[[x, y]].isna().all().any():
        st.warning(f"No data available for {title}")
        return None
    
    data_clean = data.dropna(subset=[x, y])
    
    if color_col and color_col in data_clean.columns:
        fig = px.scatter(
            data_clean, x=x, y=y,
            color=color_col,
            title=title,
            labels={x: x_label, y: y_label},
            height=600,
            hover_data={"location": True, color_col: True},
        )
    else:
        fig = px.scatter(
            data_clean, x=x, y=y,
            title=title,
            labels={x: x_label, y: y_label},
            height=600,
        )
    
    fig.update_traces(
        marker=dict(size=8, opacity=0.7, line=dict(width=1, color="white")),
        hovertemplate="<b>%{customdata[0]}</b><br>" + x_label + ": %{x:,.0f}<br>" + y_label + ": %{y:,.0f}<extra></extra>"
    )
    fig.update_layout(
        template="plotly_white",
        font=dict(size=12),
        title_font_size=16,
        margin=dict(l=80, r=50, t=100, b=80),
    )
    return fig


