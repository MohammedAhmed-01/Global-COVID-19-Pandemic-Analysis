@st.cache_data
def load_data():
    """Load all processed datasets with error handling."""
    try:
        base_path = Path(__file__).parent / "Data" / "Processed"
        
        # Load datasets
        final_df = pd.read_csv(base_path / "final_dataset.csv")
        country_summary = pd.read_csv(base_path / "country_summary.csv")
        continent_summary = pd.read_csv(base_path / "continent_summary.csv")
        global_summary = pd.read_csv(base_path / "global_summary.csv")
        
        # Convert date columns
        if "date" in final_df.columns:
            final_df["date"] = pd.to_datetime(final_df["date"])
        if "date" in country_summary.columns:
            country_summary["date"] = pd.to_datetime(country_summary["date"])
        
        return {
            "final": final_df,
            "country": country_summary,
            "continent": continent_summary,
            "global": global_summary,
        }
    except Exception as e:
        st.error(f"Error loading data: {str(e)}")
        return None


def safe_col(df, col_name, default=None):
    """Safely get a column from dataframe, return default if missing."""
    return df.get(col_name, default) if isinstance(df, dict) else (
        df[col_name] if col_name in df.columns else default
    )


def format_number(val):
    """Format large numbers with K/M/B suffix."""
    if pd.isna(val) or val == 0:
        return "0"
    abs_val = abs(val)
    if abs_val >= 1e9:
        return f"{val / 1e9:.1f}B"
    elif abs_val >= 1e6:
        return f"{val / 1e6:.1f}M"
    elif abs_val >= 1e3:
        return f"{val / 1e3:.1f}K"
    else:
        return f"{val:.1f}"


